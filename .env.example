# Configuration Example
# Copy this to .env and fill in your actual values

# ============================================================================
# LLM PROVIDER SELECTION
# ============================================================================
# Choose which LLM provider to use: "openai" or "anthropic"
LLM_PROVIDER=openai

# ============================================================================
# OPENAI CONFIGURATION
# ============================================================================
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# ============================================================================
# ANTHROPIC CONFIGURATION
# ============================================================================
# Get your API key from: https://console.anthropic.com/keys
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-1

# ============================================================================
# LANGSMITH CONFIGURATION (Optional)
# ============================================================================
# Enable LangSmith tracing for debugging and monitoring
# Get your API key from: https://smith.langchain.com/
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=codebase-analysis
LANGSMITH_TRACING_V2=true

# ============================================================================
# SERVICE CONFIGURATION
# ============================================================================
SERVICE_PORT=8000
SERVICE_HOST=0.0.0.0

# ============================================================================
# WORKSPACE CONFIGURATION
# ============================================================================
# Where cloned repositories will be stored temporarily
WORKSPACE_ROOT=/tmp/workspaces
# Whether to automatically clean up workspaces after processing
WORKSPACE_CLEANUP=true

# ============================================================================
# MCP SERVER CONFIGURATION
# ============================================================================
# GitHub MCP Server
# Get your token from: https://github.com/settings/tokens
# Scopes: repo (full control of private repositories), public_repo
GITHUB_PERSONAL_ACCESS_TOKEN=

# Filesystem MCP Server
# Root directory that the Filesystem MCP can access
FILESYSTEM_MCP_ROOT=/tmp/workspaces

# ============================================================================
# LOGGING
# ============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
